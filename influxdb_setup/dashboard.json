        "type": "view",
        "attributes": {
          "name": "Laatste Knop Ingedrukt",
          "properties": {
            "type": "single-stat",
            "queries": [
              {
                "text": "from(bucket: \"sensor_data\")\n  |> range(start: -24h, stop: now())\n  |> filter(fn: (r) => r[\"_measurement\"] == \"button_data\")\n  |> filter(fn: (r) => r[\"_field\"] == \"button_name\" or r[\"_field\"] == \"pressed\")\n  |> last()",
