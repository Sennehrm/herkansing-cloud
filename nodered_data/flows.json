    {
        "id": "76e58918684e9c6f",
        "type": "function",
        "z": "1d733e03594f5ff4",
        "name": "Validatie & Datalogica",
        "func": "// 1. Verwerk Joysticks (splitst joystick1 en joystick2op)\nif (msg.topic.includes('joystick')) {\n    let data;\n    try {\n        data = typeof msg.payload === 'object' ? msg.payload : JSON.parse(msg.payload);\n    } catch (e) {\n        return null;\n    }\n\n    let x = Number(data.x);\n    let y = Number(data.y);\n\n    // Validatie\n    if (isNaN(x) || isNaN(y) || x < 0 || x > 255 || y < 0 || y > 255) {\n        return null;\n    }\n\n    // Zet de measurement exact op \"joystick1\" of \"joystick2\"\n    if (msg.topic.includes('joystick1')) {\n        msg.measurement = \"joystick1\";\n    } else if (msg.topic.includes('joystick2')) {\n        msg.measurement = \"joystick2\";\n    }\n\n    msg.payload = { x: x, y: y };\n    return msg;\n}\n\n// 2. Verwerk Knoppen\nif (msg.topic.includes('buttons')) {\n    let btn = String(msg.payload).replace(/[\"'\\r\\n]/g, '').trim();\n\n    const buttonMap = {\n        \"X\": 0, \"B\": 1, \"A\": 2, \"Y\": 3,\n        \"R1\": 4, \"L1\": 5, \"R2\": 6, \"L2\": 7\n    };\n\n    let buttonId = buttonMap[btn];\n    if (buttonId === undefined) return null;\n\n    msg.measurement = \"button_data\";\n    msg.payload = {\n        button_id: buttonId,\n        button_name: btn,\n        pressed: 1\n    };\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
